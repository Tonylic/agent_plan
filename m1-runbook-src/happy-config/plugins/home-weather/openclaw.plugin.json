{
  "id": "home-weather",
  "name": "Home Weather",
  "description": "National Weather Service forecast for the family's home town (home_weather tool).",
  "version": "0.1.0",
  "activation": { "onStartup": true },
  "contracts": { "tools": ["home_weather"] },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["place", "latitude", "longitude", "userAgent"],
    "properties": {
      "place": { "type": "string", "minLength": 3, "maxLength": 80, "description": "Display name, e.g. a town and state." },
      "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
      "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
      "userAgent": { "type": "string", "minLength": 8, "maxLength": 200, "description": "NWS asks for an app name and a contact." }
    }
  }
}
