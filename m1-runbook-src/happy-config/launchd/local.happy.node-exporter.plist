<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- node_exporter (O1), only the filesystem and meminfo collectors, data volume only. Default listen is :9100
     on every interface, so bind it. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>local.happy.node-exporter</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node_exporter</string>
    <string>--web.listen-address=127.0.0.1:9100</string>
    <string>--collector.disable-defaults</string>
    <string>--collector.filesystem</string>
    <string>--collector.meminfo</string>
    <string>--collector.filesystem.mount-points-include=^/System/Volumes/Data$</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/happy</string>
  </dict>
  <key>WorkingDirectory</key><string>/Users/happy</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>/Users/happy/Library/Logs/happy/node-exporter.log</string>
  <key>StandardErrorPath</key><string>/Users/happy/Library/Logs/happy/node-exporter.log</string>
</dict>
</plist>
