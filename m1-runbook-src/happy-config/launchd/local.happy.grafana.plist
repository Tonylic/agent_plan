<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Grafana (O1), run by happy, 127.0.0.1:3000. Binary and homepath from tonyli's Homebrew; config,
     data, logs and provisioning all live in happy's home (Homebrew's var/ is admin-owned). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>local.happy.grafana</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/grafana</string>
    <string>server</string>
    <string>--config</string><string>/Users/happy/.config/happy/observability/grafana/grafana.ini</string>
    <string>--homepath</string><string>/opt/homebrew/opt/grafana/share/grafana</string>
    <string>--packaging=brew</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/happy</string>
  </dict>
  <key>WorkingDirectory</key><string>/Users/happy/.local/share/grafana</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>/Users/happy/Library/Logs/happy/grafana.log</string>
  <key>StandardErrorPath</key><string>/Users/happy/Library/Logs/happy/grafana.log</string>
</dict>
</plist>
