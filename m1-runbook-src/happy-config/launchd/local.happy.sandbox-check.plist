<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Sandbox check (O1): every 60 s, is Colima's Docker engine answering, with the sandbox image present?
     Pushes happy_sandbox_ready to VictoriaMetrics; Grafana alerts on 0 or on silence. Logs only failures. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>local.happy.sandbox-check</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/happy/bin/happy-sandbox-check</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/happy</string>
  </dict>
  <key>WorkingDirectory</key><string>/Users/happy</string>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>60</integer>
  <key>StandardOutPath</key><string>/Users/happy/Library/Logs/happy/sandbox-check.log</string>
  <key>StandardErrorPath</key><string>/Users/happy/Library/Logs/happy/sandbox-check.log</string>
</dict>
</plist>
