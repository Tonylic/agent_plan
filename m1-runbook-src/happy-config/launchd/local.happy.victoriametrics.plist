<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- VictoriaMetrics single-node (O1), run by happy, loopback only. Binary installed by tonyli via Homebrew.
     The wrapper copies the gateway token from happy's Keychain into a 0600 file, then execs VM. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>local.happy.victoriametrics</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/happy/bin/happy-victoriametrics</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/happy</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>WorkingDirectory</key><string>/Users/happy</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>ExitTimeOut</key><integer>60</integer>   <!-- let VM flush in-memory parts on SIGTERM -->
  <key>StandardOutPath</key><string>/Users/happy/Library/Logs/happy/victoriametrics.log</string>
  <key>StandardErrorPath</key><string>/Users/happy/Library/Logs/happy/victoriametrics.log</string>
</dict>
</plist>
