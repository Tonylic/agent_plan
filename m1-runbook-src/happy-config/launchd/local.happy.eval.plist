<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- E0 eval job. No schedule and no RunAtLoad: it runs only when happy-deploy starts it, after a deploy
     (it then checks whether the critical path changed) or on demand (happy-deploy --run-eval). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>local.happy.eval</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/happy/bin/happy-eval</string>
    <string>--if-changed</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/happy</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>WorkingDirectory</key><string>/Users/happy</string>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>/Users/happy/Library/Logs/happy/eval.log</string>
  <key>StandardErrorPath</key><string>/Users/happy/Library/Logs/happy/eval.log</string>
</dict>
</plist>
