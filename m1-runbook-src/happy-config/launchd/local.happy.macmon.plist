<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macmon Prometheus exporter (O1): power, temperature, RAM and swap. Default host is 0.0.0.0, so bind it. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>local.happy.macmon</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/macmon</string>
    <string>serve</string>
    <string>--host</string><string>127.0.0.1</string>
    <string>--port</string><string>9090</string>
    <string>--interval</string><string>5000</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/happy</string>
  </dict>
  <key>WorkingDirectory</key><string>/Users/happy</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/happy/Library/Logs/happy/macmon.log</string>
  <key>StandardErrorPath</key><string>/Users/happy/Library/Logs/happy/macmon.log</string>
</dict>
</plist>
