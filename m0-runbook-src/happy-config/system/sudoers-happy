# /etc/sudoers.d/happy  (file name must not contain a dot, or sudo skips it)
# tonyli may run these two root-owned scripts as happy without a password;
# everything else still needs tonyli's password.
Defaults>happy always_set_home
tonyli ALL=(happy) NOPASSWD: /usr/local/libexec/happy-deploy, /usr/local/libexec/happy-inspect
