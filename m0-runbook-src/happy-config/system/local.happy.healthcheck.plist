<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Dead-man probe. System daemon (runs at boot, no login needed) as the unprivileged "nobody" user. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>local.happy.healthcheck</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/libexec/happy-healthcheck</string>
  </array>
  <key>UserName</key><string>nobody</string>
  <key>GroupName</key><string>nobody</string>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>/var/log/happy-healthcheck.log</string>
  <key>StandardErrorPath</key><string>/var/log/happy-healthcheck.log</string>
</dict>
</plist>
