<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Colima VM for the OpenClaw sandbox. Runs in happy's GUI session; starts at happy's login.
     Mounts only ~/.openclaw/sandboxes (Colima's default would mount all of $HOME read-write). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>local.happy.colima</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/happy/bin/happy-colima-start</string>   <!-- clears a stale vz.pid, then runs colima start --foreground -->
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/happy</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>WorkingDirectory</key><string>/Users/happy</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>   <!-- retry a failed start; a clean stop stays stopped -->
  <key>ThrottleInterval</key><integer>60</integer>
  <key>ExitTimeOut</key><integer>120</integer>   <!-- give the VM time to stop cleanly -->
  <key>StandardOutPath</key><string>/Users/happy/Library/Logs/happy/colima.log</string>
  <key>StandardErrorPath</key><string>/Users/happy/Library/Logs/happy/colima.log</string>
</dict>
</plist>
