<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Ollama server, run by happy, bound to loopback only. Binary is installed by tonyli via Homebrew.
     No models are pulled in M0; that is M2. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>local.happy.ollama</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/ollama</string>
    <string>serve</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/happy</string>
    <key>OLLAMA_HOST</key><string>127.0.0.1:11434</string>
    <key>OLLAMA_NO_CLOUD</key><string>1</string>
  </dict>
  <key>WorkingDirectory</key><string>/Users/happy</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/happy/Library/Logs/happy/ollama.log</string>
  <key>StandardErrorPath</key><string>/Users/happy/Library/Logs/happy/ollama.log</string>
</dict>
</plist>
