<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Egress proxy for the Gmail connector (wave A): tinyproxy on 127.0.0.1:8877, in the foreground,
     allowing HTTPS tunnels to the hosts in ~/.config/happy/egress/allow-hosts and nothing else.
     Its own log is ~/Library/Logs/happy/egress-proxy.log (one line per request and decision). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>local.happy.egress-proxy</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/opt/tinyproxy/bin/tinyproxy</string>
    <string>-d</string>
    <string>-c</string>
    <string>/Users/happy/.config/happy/egress/tinyproxy.conf</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/happy</string>
  </dict>
  <key>WorkingDirectory</key><string>/Users/happy</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>/Users/happy/Library/Logs/happy/egress-proxy.stderr.log</string>
  <key>StandardErrorPath</key><string>/Users/happy/Library/Logs/happy/egress-proxy.stderr.log</string>
</dict>
</plist>
