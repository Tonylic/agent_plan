<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Google sign-in check (wave A): once a day at 06:30 on the Mac's clock, and at load. Asks Google
     whether each stored sign-in still works and pushes happy_google_signin_ok to VictoriaMetrics;
     Grafana alerts on 0 or on silence. Runs in happy's login session, where the Keychain is unlocked. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>local.happy.signin-check</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/happy/bin/happy-signin-check</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/happy</string>
  </dict>
  <key>WorkingDirectory</key><string>/Users/happy</string>
  <key>RunAtLoad</key><true/>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>6</integer>
    <key>Minute</key><integer>30</integer>
  </dict>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>/Users/happy/Library/Logs/happy/signin-check.log</string>
  <key>StandardErrorPath</key><string>/Users/happy/Library/Logs/happy/signin-check.log</string>
</dict>
</plist>
